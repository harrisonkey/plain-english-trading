{
  "version": 2,
  "functions": {
    "api/*.js": {
      "runtime": "@vercel/node"
    }
  },
  "routes": [
    { "src": "/api/scan", "dest": "/scan.js" },
    { "src": "/api/analyze", "dest": "/analyze.js" },
    { "src": "/api/positions", "dest": "/positions.js" },
    { "src": "/api/screenshot", "dest": "/screenshot.js" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
